# AI Data Pipeline Design Assistant - Environment Configuration
# Copy this file to .env and fill in your actual API keys and configuration

# ============================================================================
# REQUIRED: LLM Configuration
# ============================================================================

# Anthropic Claude API Key (Required)
# Get your API key from: https://docs.anthropic.com/en/docs/quickstart
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative: For proxy configuration (e.g., Kat Coder)
# ANTHROPIC_BASE_URL=https://your-proxy-endpoint.com/claude-code-proxy
# ANTHROPIC_AUTH_TOKEN=your_proxy_auth_token_here

# Model Configuration
# Available models: claude-3-5-sonnet-latest, claude-3-haiku-20240307, etc.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_SMALL_FAST_MODEL=claude-3-haiku-20240307

# ============================================================================
# OPTIONAL: Additional Services
# ============================================================================

# OpenAI API Key (Optional - for image generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# API Configuration
# ============================================================================

# API Timeout in milliseconds (default: 5 minutes)
API_TIMEOUT_MS=300000

# Disable non-essential traffic for Claude Code (optional)
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ============================================================================
# Application Configuration
# ============================================================================

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application Environment: development, staging, production
ENVIRONMENT=development

# ============================================================================
# Security Notes
# ============================================================================
# 
# 1. NEVER commit .env files with real credentials to version control
# 2. Use strong, unique API keys for each environment
# 3. Rotate API keys regularly
# 4. Monitor API usage and set up alerts for unusual activity
# 5. Use environment-specific keys (different keys for dev/staging/prod)
# 6. Restrict API key permissions to minimum required scope
#
# For production deployments:
# - Use a secrets management service (AWS Secrets Manager, HashiCorp Vault)
# - Implement proper IAM roles and policies
# - Enable audit logging and monitoring
# - Use HTTPS for all API communications
#
# ============================================================================